{
	"name": "shadcn-ui-monorepo",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"check-types": "turbo check-types",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"test": "bun test packages/api --env-file=.env",
		"test:watch": "bun test packages/api --watch --env-file=.env"
	},
	"devDependencies": {
		"@workspace/typescript-config": "workspace:*",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"turbo": "^2.5.5",
		"typescript": "5.7.3"
	},
	"packageManager": "bun@1.2.2",
	"engines": {
		"node": ">=20"
	}
}
